####################################################################
# 题目四：强化学习 —— 凭证配置模板
#
# 用法：cp .env.example .env  然后填入真实值
# ⚠️ .env 绝对不要提交 Git（已在 .gitignore 中忽略），凭证只从环境读取，
#    不写死在任何代码里（driver.py / clients/ags.py / clients/cos.py 均如此）。
#
# 本项目与「课题三·数据合成」共用同一个腾讯云账号，如果你已经配置过课题三的
# .env，把对应值抄过来即可（AGS/COS/TCR 相关字段完全一致）。
####################################################################

# ------------------------------------------------------------------
# 1) 腾讯云 OpenAPI 密钥 —— 创建/管理沙箱工具、TKE、COS 都要用
#    获取：控制台 → 访问管理 CAM → 访问密钥 → API 密钥管理
#      https://console.cloud.tencent.com/cam/capi
# ------------------------------------------------------------------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-shanghai

# CAM 角色 ARN（自定义镜像拉取用，创建沙箱工具时必传）
# 形如：qcs::cam::uin/100051554448:roleName/ags-tcr-pull
AGS_ROLE_ARN=

# ------------------------------------------------------------------
# 2) 腾讯云 Agent Sandbox（AGS）—— Agent 实际解题跑在这里
#    E2B_API_KEY 获取：AGS 控制台 → API Keys → 新建
#      https://console.cloud.tencent.com/ags/sandbox
#    E2B_DOMAIN 把 E2B SDK 指向腾讯云而非 E2B 官方
# ------------------------------------------------------------------
E2B_API_KEY=
E2B_DOMAIN=ap-shanghai.tencentags.com
# 共享沙箱工具名（driver.py 默认值，可用 --tool-name 覆盖）
AGS_TOOL_NAME=swe-rl-runner

# ------------------------------------------------------------------
# 3) 容器镜像服务 —— 题目镜像所在仓库（沿用课题三产出的题目池）
# ------------------------------------------------------------------
TCR_REGISTRY=ccr.ccs.tencentyun.com
TCR_NAMESPACE=<your-tcr-namespace>
TCR_REGISTRY_TYPE=personal
# 起沙箱工具时的占位镜像（真正题目镜像会在 rollout 时按题 image_override）
SANDBOX_BASE_IMAGE=ccr.ccs.tencentyun.com/ags-image/sandbox-code:latest

# ------------------------------------------------------------------
# 4) COS —— SandBox → TKE 传递 tracing.jsonl 的通道
# ------------------------------------------------------------------
COS_REGION=ap-shanghai
COS_BUCKET=<your-cos-bucket>

# ------------------------------------------------------------------
# 5) 训练侧 vLLM（TKE GPU 上起的推理服务，Agent 在沙箱里通过公网/内网访问它）
#    Phase 2/3 实际跑起来后回填这里
# ------------------------------------------------------------------
LLM_ENDPOINT=
LLM_API_KEY=EMPTY
MODEL_NAME=
